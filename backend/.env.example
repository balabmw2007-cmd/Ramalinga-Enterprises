# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/ramalinga_enterprises
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ramalinga_enterprises
MONGODB_URI=mongodb://127.0.0.1:27017/ramalinga_enterprises

# Used to sign JWT auth tokens. Generate a long random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500
